# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/home_overview?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Resend (magic link emails)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Home Overview <noreply@yourdomain.com>"

# Local-only MCP phase 0 spike (ignored when NODE_ENV=production)
HOME_OVERVIEW_MCP_SPIKE_TOKEN="replace-with-a-random-local-token"

# MCP OAuth (MCP/OAuth routes return 503 when missing or invalid)
HOME_OVERVIEW_MCP_OAUTH_SIGNING_SECRET="generate-independently-with-openssl-rand-base64-32"
HOME_OVERVIEW_MCP_ISSUER="https://home.jenanos.xyz"
HOME_OVERVIEW_MCP_ACCESS_TOKEN_TTL_SECONDS="1800"
HOME_OVERVIEW_MCP_REFRESH_TOKEN_TTL_SECONDS="2592000"
HOME_OVERVIEW_MCP_CLOCK_SKEW_SECONDS="30"

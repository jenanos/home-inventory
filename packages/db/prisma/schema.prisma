generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js models ──────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts                 Account[]
  sessions                 Session[]
  householdMembers         HouseholdMember[]
  assignedItems            ShoppingItem[]                 @relation("AssignedItems")
  createdLists             ShoppingList[]                 @relation("CreatedShoppingLists")
  createdLinks             ShareLink[]
  mcpAuthorizationRequests McpOAuthAuthorizationRequest[]
  mcpAuthorizationCodes    McpOAuthAuthorizationCode[]
  mcpGrants                McpOAuthGrant[]
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ──────────────────────────────────────────────────

enum Role {
  OWNER
  MEMBER
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum Phase {
  BEFORE_MOVE
  FIRST_WEEK
  CAN_WAIT
  NO_RUSH
}

enum ItemStatus {
  PENDING
  PURCHASED
  SKIPPED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  members          HouseholdMember[]
  lists            ShoppingList[]
  categories       Category[]
  maintenanceTasks MaintenanceTask[]
  plants           Plant[]
  budget           Budget?
}

model HouseholdMember {
  /// Home Overview currently supports exactly one active household per user.
  /// Supporting multiple households requires an explicit active-household concept.
  userId      String @unique @db.Uuid
  householdId String @db.Uuid
  role        Role   @default(MEMBER)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@id([userId, householdId])
}

// ─── MCP OAuth models ───────────────────────────────────────────

enum McpOAuthClientRegistrationSource {
  CLIENT_ID_METADATA
  DYNAMIC
  ADMIN
}

enum McpOAuthClientStatus {
  ACTIVE
  REVOKED
}

model McpOAuthClient {
  id                 String                           @id @db.VarChar(512)
  name               String                           @db.VarChar(200)
  redirectUris       String[]
  grantTypes         String[]
  responseTypes      String[]
  clientSecretHash   String?                          @unique @db.Char(64)
  registrationSource McpOAuthClientRegistrationSource
  status             McpOAuthClientStatus             @default(ACTIVE)
  createdAt          DateTime                         @default(now())
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?

  authorizationRequests McpOAuthAuthorizationRequest[]
  authorizationCodes    McpOAuthAuthorizationCode[]
  grants                McpOAuthGrant[]

  @@index([expiresAt])
  @@index([status, revokedAt])
}

model McpOAuthAuthorizationRequest {
  id                  String    @id @default(uuid()) @db.Uuid
  requestTokenHash    String    @unique @db.Char(64)
  clientId            String    @db.VarChar(512)
  userId              String?   @db.Uuid
  redirectUri         String    @db.Text
  codeChallenge       String    @db.VarChar(128)
  codeChallengeMethod String    @db.VarChar(16)
  requestedScopes     String[]
  resource            String    @db.Text
  state               String?   @db.Text
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  consumedAt          DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?

  client McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model McpOAuthAuthorizationCode {
  id                  String    @id @default(uuid()) @db.Uuid
  codeHash            String    @unique @db.Char(64)
  clientId            String    @db.VarChar(512)
  userId              String    @db.Uuid
  redirectUri         String    @db.Text
  scopes              String[]
  resource            String    @db.Text
  codeChallenge       String    @db.VarChar(128)
  codeChallengeMethod String    @db.VarChar(16)
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  consumedAt          DateTime?

  client McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model McpOAuthGrant {
  id         String    @id @default(uuid()) @db.Uuid
  clientId   String    @db.VarChar(512)
  userId     String    @db.Uuid
  scopes     String[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?
  revokedAt  DateTime?

  client        McpOAuthClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens McpOAuthRefreshToken[]

  // Re-consent updates this row; a user/client pair never has two active grants.
  @@unique([userId, clientId])
  @@index([userId, revokedAt])
  @@index([clientId, revokedAt])
}

model McpOAuthRefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @db.Char(64)
  grantId      String    @db.Uuid
  familyId     String    @db.Uuid
  replacedById String?   @unique @db.Uuid
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  lastUsedAt   DateTime?
  consumedAt   DateTime?
  revokedAt    DateTime?

  grant      McpOAuthGrant         @relation(fields: [grantId], references: [id], onDelete: Cascade)
  replacedBy McpOAuthRefreshToken? @relation("McpRefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   McpOAuthRefreshToken? @relation("McpRefreshTokenRotation")

  @@index([grantId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model ShoppingList {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  color       String?
  householdId String   @db.Uuid
  createdById String?  @db.Uuid
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household  Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy  User?          @relation("CreatedShoppingLists", fields: [createdById], references: [id], onDelete: SetNull)
  items      ShoppingItem[]
  shareLinks ShareLink[]

  @@index([householdId, isPrivate])
}

model ShoppingItem {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  categoryId     String?    @db.Uuid
  priority       Priority   @default(MEDIUM)
  phase          Phase?
  dueDate        DateTime?
  estimatedPrice Decimal?   @db.Decimal(10, 2)
  url            String?
  imageUrl       String?
  storeName      String?
  assignedToId   String?    @db.Uuid
  status         ItemStatus @default(PENDING)
  purchasedAt    DateTime?
  listId         String     @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedTo   User?                @relation("AssignedItems", fields: [assignedToId], references: [id], onDelete: SetNull)
  list         ShoppingList         @relation(fields: [listId], references: [id], onDelete: Cascade)
  alternatives ProductAlternative[]
}

model ProductAlternative {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  price     Decimal? @db.Decimal(10, 2)
  url       String?
  imageUrl  String?
  storeName String?
  notes     String?
  rank      Int      @default(0)
  itemId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item ShoppingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, rank])
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  icon        String?
  color       String?
  householdId String  @db.Uuid
  isDefault   Boolean @default(false)

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingItem[]

  @@unique([name, householdId])
}

model ShareLink {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  listId    String    @db.Uuid
  createdBy String    @db.Uuid
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  list    ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  creator User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}

// ─── Maintenance models ─────────────────────────────────────────

model MaintenanceTask {
  id                String     @id @default(uuid()) @db.Uuid
  title             String
  description       String?    @db.Text
  priority          Priority   @default(MEDIUM)
  status            TaskStatus @default(NOT_STARTED)
  estimatedDuration String?
  estimatedPrice    Decimal?   @db.Decimal(10, 2)
  dueDate           DateTime?
  householdId       String     @db.Uuid
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  household       Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vendors         TaskVendor[]
  progressEntries TaskProgressEntry[]
}

model TaskVendor {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  description    String?  @db.Text
  phone          String?
  email          String?
  website        String?
  estimatedPrice Decimal? @db.Decimal(10, 2)
  notes          String?  @db.Text
  isSelected     Boolean  @default(false)
  taskId         String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskProgressEntry {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  sortOrder   Int       @default(0)
  taskId      String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

// ─── Hage / Planter models ──────────────────────────────────────

enum WateringNeed {
  LOW
  MEDIUM
  HIGH
}

enum WateringMethod {
  MANUAL
  AUTOMATIC
}

enum SunNeed {
  FULL_SUN // Mye sol
  PARTIAL_SHADE // Halvskygge
  SHADE // Skygge / lite sol
}

enum PlantType {
  TREE // Tre
  SHRUB // Busk
  PERENNIAL // Staude
  ANNUAL // Ettårig
  FLOWER // Blomst
  HERB // Krydder/urt
  VEGETABLE // Grønnsak
  CLIMBER // Klatreplante
  GRASS // Gress/prydgress
  OTHER
}

enum Lifecycle {
  ANNUAL // Ettårig
  BIENNIAL // Toårig
  PERENNIAL // Flerårig
}

model Plant {
  id               String          @id @default(uuid()) @db.Uuid
  name             String
  species          String?
  location         String?
  description      String?         @db.Text
  careInstructions String?         @db.Text
  wateringNeed     WateringNeed?
  wateringMethod   WateringMethod?
  lastWateredAt    DateTime?
  sunNeed          SunNeed?
  lastPrunedAt     DateTime?
  pruningSeason    String?
  isToxic          Boolean         @default(false)
  toxicityNotes    String?
  plantType        PlantType?
  soilType         String?
  fertilizer       String?
  hardinessZone    String?
  lifecycle        Lifecycle?
  bloomTime        String?
  plantedAt        DateTime?
  pests            String?         @db.Text
  notes            String?         @db.Text
  imageUrl         String?
  sourceUrl        String?
  householdId      String          @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

// ─── Budget models ──────────────────────────────────────────────

enum BudgetEntryType {
  INCOME
  EXPENSE
  DEDUCTION
}

enum BudgetLoanType {
  MORTGAGE
  OTHER
}

enum BudgetLoanRepaymentType {
  ANNUITY
  SERIAL
}

enum TripTransportType {
  AIR_OR_PUBLIC
  CAR
}

model Budget {
  id                  String   @id @default(uuid()) @db.Uuid
  householdId         String   @unique @db.Uuid
  taxDeductionPercent Decimal  @default(22) @db.Decimal(5, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  household  Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  members    BudgetMember[]
  loans      BudgetLoan[]
  trips      BudgetTrip[]
  categories BudgetEntryCategory[]
  entries    BudgetEntry[]
}

model BudgetEntryCategory {
  id        String   @id @default(uuid()) @db.Uuid
  budgetId  String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget  Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  entries BudgetEntry[]

  @@unique([budgetId, name])
  @@index([budgetId, sortOrder])
}

model BudgetMember {
  id                 String   @id @default(uuid()) @db.Uuid
  budgetId           String   @db.Uuid
  name               String
  grossMonthlyIncome Decimal  @db.Decimal(10, 2)
  taxPercent         Decimal  @db.Decimal(5, 2)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, sortOrder])
}

model BudgetLoan {
  id                 String                  @id @default(uuid()) @db.Uuid
  budgetId           String                  @db.Uuid
  bankName           String
  loanName           String
  loanType           BudgetLoanType          @default(MORTGAGE)
  repaymentType      BudgetLoanRepaymentType @default(ANNUITY)
  principalAmount    Decimal                 @default(0) @db.Decimal(14, 2)
  annualInterestRate Decimal                 @default(0) @db.Decimal(6, 3)
  termMonths         Int                     @default(12)
  monthlyFees        Decimal                 @default(0) @db.Decimal(10, 2)
  sortOrder          Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, sortOrder])
}

model BudgetTrip {
  id            String            @id @default(uuid()) @db.Uuid
  budgetId      String            @db.Uuid
  name          String
  transportType TripTransportType
  annualTrips   Int               @default(1)
  ticketPerTrip Decimal?          @db.Decimal(10, 2)
  tollPerTrip   Decimal?          @db.Decimal(10, 2)
  ferryPerTrip  Decimal?          @db.Decimal(10, 2)
  fuelPerTrip   Decimal?          @db.Decimal(10, 2)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, sortOrder])
}

model BudgetEntry {
  id            String          @id @default(uuid()) @db.Uuid
  budgetId      String          @db.Uuid
  name          String
  categoryId    String?         @db.Uuid
  type          BudgetEntryType
  monthlyAmount Decimal         @db.Decimal(10, 2)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  budget   Budget               @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category BudgetEntryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([budgetId, sortOrder])
  @@index([categoryId])
}

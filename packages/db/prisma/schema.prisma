generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js models ──────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts                 Account[]
  sessions                 Session[]
  householdMembers         HouseholdMember[]
  assignedItems            ShoppingItem[]                 @relation("AssignedItems")
  createdLists             ShoppingList[]                 @relation("CreatedShoppingLists")
  createdLinks             ShareLink[]
  mcpAuthorizationRequests McpOAuthAuthorizationRequest[]
  mcpAuthorizationCodes    McpOAuthAuthorizationCode[]
  mcpGrants                McpOAuthGrant[]
  mcpAuditEvents           McpAuditEvent[]
  uploadedAttachments      Attachment[]
  attachmentUploadLinks    AttachmentUploadLink[]
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ──────────────────────────────────────────────────

enum Role {
  OWNER
  MEMBER
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

/// When an item is needed. Replaced the move-in phases (BEFORE_MOVE,
/// FIRST_WEEK, …) in migration 20261108120000.
enum Timeframe {
  NOW
  SOON
  LATER
  SOMEDAY
}

enum ItemStatus {
  PENDING
  PURCHASED
  SKIPPED
}

/// Renamed from TaskStatus in migration 20261108170000.
enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

/// What kind of project it is. Existing maintenance tasks became MAINTENANCE.
enum ProjectType {
  MAINTENANCE
  REPAIR
  RENOVATION
  IMPROVEMENT
  OTHER
}

/// Who does the work. Null means not decided yet.
enum ProjectExecution {
  SELF
  VENDOR
  MIXED
}

model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  members        HouseholdMember[]
  lists          ShoppingList[]
  categories     Category[]
  projects       Project[]
  plants         Plant[]
  gardenBeds     GardenBed[]
  attachments    Attachment[]
  uploadLinks    AttachmentUploadLink[]
  budget         Budget?
  mcpAuditEvents McpAuditEvent[]
}

model HouseholdMember {
  /// Home Overview currently supports exactly one active household per user.
  /// Supporting multiple households requires an explicit active-household concept.
  userId      String @unique @db.Uuid
  householdId String @db.Uuid
  role        Role   @default(MEMBER)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@id([userId, householdId])
}

// ─── MCP OAuth models ───────────────────────────────────────────

enum McpOAuthClientRegistrationSource {
  CLIENT_ID_METADATA
  DYNAMIC
  ADMIN
}

enum McpOAuthClientStatus {
  ACTIVE
  REVOKED
}

model McpOAuthClient {
  id                 String                           @id @db.VarChar(512)
  name               String                           @db.VarChar(200)
  redirectUris       String[]
  grantTypes         String[]
  responseTypes      String[]
  clientSecretHash   String?                          @unique @db.Char(64)
  registrationSource McpOAuthClientRegistrationSource
  status             McpOAuthClientStatus             @default(ACTIVE)
  createdAt          DateTime                         @default(now())
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?

  authorizationRequests McpOAuthAuthorizationRequest[]
  authorizationCodes    McpOAuthAuthorizationCode[]
  grants                McpOAuthGrant[]

  @@index([expiresAt])
  @@index([status, revokedAt])
}

model McpOAuthAuthorizationRequest {
  id                  String    @id @default(uuid()) @db.Uuid
  requestTokenHash    String    @unique @db.Char(64)
  clientId            String    @db.VarChar(512)
  userId              String?   @db.Uuid
  redirectUri         String    @db.Text
  codeChallenge       String    @db.VarChar(128)
  codeChallengeMethod String    @db.VarChar(16)
  requestedScopes     String[]
  resource            String    @db.Text
  state               String?   @db.Text
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  consumedAt          DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?

  client McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model McpOAuthAuthorizationCode {
  id                  String    @id @default(uuid()) @db.Uuid
  codeHash            String    @unique @db.Char(64)
  clientId            String    @db.VarChar(512)
  userId              String    @db.Uuid
  redirectUri         String    @db.Text
  scopes              String[]
  resource            String    @db.Text
  codeChallenge       String    @db.VarChar(128)
  codeChallengeMethod String    @db.VarChar(16)
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  consumedAt          DateTime?

  client McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model McpOAuthGrant {
  id         String    @id @default(uuid()) @db.Uuid
  clientId   String    @db.VarChar(512)
  userId     String    @db.Uuid
  scopes     String[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?
  revokedAt  DateTime?

  client        McpOAuthClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens McpOAuthRefreshToken[]

  // Re-consent updates this row; a user/client pair never has two active grants.
  @@unique([userId, clientId])
  @@index([userId, revokedAt])
  @@index([clientId, revokedAt])
}

model McpOAuthRefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @db.Char(64)
  grantId      String    @db.Uuid
  familyId     String    @db.Uuid
  replacedById String?   @unique @db.Uuid
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  lastUsedAt   DateTime?
  consumedAt   DateTime?
  revokedAt    DateTime?

  grant      McpOAuthGrant         @relation(fields: [grantId], references: [id], onDelete: Cascade)
  replacedBy McpOAuthRefreshToken? @relation("McpRefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   McpOAuthRefreshToken? @relation("McpRefreshTokenRotation")

  @@index([grantId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

/// One row per MCP mutation attempt (chapter 12 of the MCP plan). Deliberately
/// holds no tool input, no before/after copies and no free text: only who, which
/// client, which tool, which resource and how it went. Rows are removed by the
/// periodic cleanup after the retention period, and with the user or household.
model McpAuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now())
  userId        String   @db.Uuid
  householdId   String   @db.Uuid
  /// Not a foreign key: the trail should survive a client being removed.
  clientId      String   @db.VarChar(512)
  toolName      String   @db.VarChar(100)
  resourceType  String   @db.VarChar(50)
  resourceId    String?  @db.Uuid
  /// `success`, `dry_run` or a lowercased application error code.
  outcome       String   @db.VarChar(32)
  correlationId String?  @db.Uuid
  durationMs    Int

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@index([clientId, createdAt])
  @@index([createdAt])
}

/// Database-only invariant, not expressible in Prisma (migration
/// 20260427141000): `CHECK (NOT "isPrivate" OR "createdById" IS NOT NULL)`.
/// A private list always has an owner, so `createdBy`'s `SetNull` would fail for
/// private lists; deleting a user removes their private lists first
/// (`lib/application/users/delete.ts`).
model ShoppingList {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  color       String?
  householdId String   @db.Uuid
  createdById String?  @db.Uuid
  isPrivate   Boolean  @default(false)
  /// Optional project the list buys for. Must be in the same household; the
  /// shopping write services enforce that. Deleting the project keeps the list.
  projectId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household  Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy  User?          @relation("CreatedShoppingLists", fields: [createdById], references: [id], onDelete: SetNull)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items      ShoppingItem[]
  shareLinks ShareLink[]

  @@index([householdId, isPrivate])
  @@index([projectId])
}

model ShoppingItem {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  categoryId     String?    @db.Uuid
  priority       Priority   @default(MEDIUM)
  timeframe      Timeframe?
  dueDate        DateTime?
  estimatedPrice Decimal?   @db.Decimal(10, 2)
  url            String?
  imageUrl       String?
  storeName      String?
  assignedToId   String?    @db.Uuid
  status         ItemStatus @default(PENDING)
  purchasedAt    DateTime?
  listId         String     @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedTo   User?                @relation("AssignedItems", fields: [assignedToId], references: [id], onDelete: SetNull)
  list         ShoppingList         @relation(fields: [listId], references: [id], onDelete: Cascade)
  alternatives ProductAlternative[]
}

model ProductAlternative {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  price     Decimal? @db.Decimal(10, 2)
  url       String?
  imageUrl  String?
  storeName String?
  notes     String?
  rank      Int      @default(0)
  itemId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item ShoppingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, rank])
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  icon        String?
  color       String?
  householdId String  @db.Uuid
  isDefault   Boolean @default(false)

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingItem[]

  @@unique([name, householdId])
}

model ShareLink {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  listId    String    @db.Uuid
  createdBy String    @db.Uuid
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  list    ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  creator User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}

// ─── Project models ─────────────────────────────────────────────
//
// Renamed from MaintenanceTask, TaskVendor and TaskProgressEntry in migration
// 20261108170000: the page started as a move-in maintenance list and now holds
// every home project, whether done by a vendor or by the household itself.

model Project {
  id                String            @id @default(uuid()) @db.Uuid
  title             String
  description       String?           @db.Text
  type              ProjectType       @default(OTHER)
  execution         ProjectExecution?
  priority          Priority          @default(MEDIUM)
  status            ProjectStatus     @default(NOT_STARTED)
  estimatedDuration String?
  estimatedPrice    Decimal?          @db.Decimal(10, 2)
  dueDate           DateTime?
  householdId       String            @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  household     Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vendors       ProjectVendor[]
  steps         ProjectStep[]
  shoppingLists ShoppingList[]
  attachments   Attachment[]

  @@index([householdId, status])
}

model ProjectVendor {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  description    String?  @db.Text
  phone          String?
  email          String?
  website        String?
  estimatedPrice Decimal? @db.Decimal(10, 2)
  notes          String?  @db.Text
  isSelected     Boolean  @default(false)
  projectId      String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectStep {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  sortOrder   Int       @default(0)
  projectId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

// ─── Hage / Planter models ──────────────────────────────────────

enum WateringNeed {
  LOW
  MEDIUM
  HIGH
}

enum WateringMethod {
  MANUAL
  AUTOMATIC
}

enum SunNeed {
  FULL_SUN // Mye sol
  PARTIAL_SHADE // Halvskygge
  SHADE // Skygge / lite sol
}

enum PlantType {
  TREE // Tre
  SHRUB // Busk
  PERENNIAL // Staude
  ANNUAL // Ettårig
  FLOWER // Blomst
  HERB // Krydder/urt
  VEGETABLE // Grønnsak
  CLIMBER // Klatreplante
  GRASS // Gress/prydgress
  OTHER
}

enum Lifecycle {
  ANNUAL // Ettårig
  BIENNIAL // Toårig
  PERENNIAL // Flerårig
}

model Plant {
  id               String          @id @default(uuid()) @db.Uuid
  name             String
  species          String?
  description      String?         @db.Text
  careInstructions String?         @db.Text
  wateringNeed     WateringNeed?
  wateringMethod   WateringMethod?
  lastWateredAt    DateTime?
  sunNeed          SunNeed?
  lastPrunedAt     DateTime?
  pruningSeason    String?
  isToxic          Boolean         @default(false)
  toxicityNotes    String?
  plantType        PlantType?
  soilType         String?
  fertilizer       String?
  hardinessZone    String?
  lifecycle        Lifecycle?
  bloomTime        String?
  plantedAt        DateTime?
  pests            String?         @db.Text
  notes            String?         @db.Text
  imageUrl         String?
  sourceUrl        String?
  householdId      String          @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  placements  PlantPlacement[]
  attachments Attachment[]

  @@index([householdId])
}

/// A named bed or area in the garden. One plant can grow in several beds, so
/// placement is a separate join row rather than a field on the plant.
model GardenBed {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?  @db.Text
  sunExposure SunNeed?
  notes       String?  @db.Text
  householdId String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  placements  PlantPlacement[]
  attachments Attachment[]

  @@unique([householdId, name])
}

/// Where a plant grows. At most one row per plant and bed.
model PlantPlacement {
  id        String   @id @default(uuid()) @db.Uuid
  plantId   String   @db.Uuid
  bedId     String   @db.Uuid
  quantity  Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plant Plant     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  bed   GardenBed @relation(fields: [bedId], references: [id], onDelete: Cascade)

  @@unique([plantId, bedId])
  @@index([bedId])
}

// ─── Budget models ──────────────────────────────────────────────

enum BudgetEntryType {
  INCOME
  EXPENSE
  DEDUCTION
  SAVINGS
}

/// How often a budget entry's amount occurs. The calculation turns it into a
/// monthly amount; the stored amount stays what the bill or payslip says.
enum BudgetFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

enum BudgetLoanType {
  MORTGAGE
  STUDENT
  CAR
  CONSUMER
  OTHER
}

enum BudgetLoanRepaymentType {
  ANNUITY
  SERIAL
}

enum TripTransportType {
  AIR_OR_PUBLIC
  CAR
}

model Budget {
  id                  String   @id @default(uuid()) @db.Uuid
  householdId         String   @unique @db.Uuid
  taxDeductionPercent Decimal  @default(22) @db.Decimal(5, 2)
  /// Market value of the home, for the loan-to-value ratio.
  propertyValue       Decimal? @db.Decimal(14, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  household  Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  members    BudgetMember[]
  loans      BudgetLoan[]
  trips      BudgetTrip[]
  categories BudgetEntryCategory[]
  entries    BudgetEntry[]
}

model BudgetEntryCategory {
  id        String   @id @default(uuid()) @db.Uuid
  budgetId  String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget  Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  entries BudgetEntry[]

  @@unique([budgetId, name])
  @@index([budgetId, sortOrder])
}

model BudgetMember {
  id                 String   @id @default(uuid()) @db.Uuid
  budgetId           String   @db.Uuid
  name               String
  grossMonthlyIncome Decimal  @db.Decimal(10, 2)
  taxPercent         Decimal  @db.Decimal(5, 2)
  /// Actual monthly payout. When set it replaces gross × (1 − tax).
  netMonthlyIncome   Decimal? @db.Decimal(10, 2)
  notes              String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, sortOrder])
}

model BudgetLoan {
  id                 String                  @id @default(uuid()) @db.Uuid
  budgetId           String                  @db.Uuid
  bankName           String
  loanName           String
  loanType           BudgetLoanType          @default(MORTGAGE)
  repaymentType      BudgetLoanRepaymentType @default(ANNUITY)
  principalAmount    Decimal                 @default(0) @db.Decimal(14, 2)
  annualInterestRate Decimal                 @default(0) @db.Decimal(6, 3)
  termMonths         Int                     @default(12)
  monthlyFees        Decimal                 @default(0) @db.Decimal(10, 2)
  fixedRateUntil     DateTime?               @db.Date
  notes              String?
  sortOrder          Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, sortOrder])
}

model BudgetTrip {
  id            String            @id @default(uuid()) @db.Uuid
  budgetId      String            @db.Uuid
  name          String
  transportType TripTransportType
  annualTrips   Int               @default(1)
  ticketPerTrip Decimal?          @db.Decimal(10, 2)
  tollPerTrip   Decimal?          @db.Decimal(10, 2)
  ferryPerTrip  Decimal?          @db.Decimal(10, 2)
  fuelPerTrip   Decimal?          @db.Decimal(10, 2)
  /// Parking, accommodation and the like. Applies to every transport type.
  otherPerTrip  Decimal?          @db.Decimal(10, 2)
  notes         String?
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, sortOrder])
}

model BudgetEntry {
  id          String          @id @default(uuid()) @db.Uuid
  budgetId    String          @db.Uuid
  name        String
  categoryId  String?         @db.Uuid
  type        BudgetEntryType
  /// The amount per occurrence, in NOK. See `frequency`.
  amount      Decimal         @db.Decimal(10, 2)
  frequency   BudgetFrequency @default(MONTHLY)
  provider    String?
  /// Day of the month the money comes in or goes out, 1–31.
  paymentDay  Int?
  /// When a contract's binding period ends or it renews.
  renewalDate DateTime?       @db.Date
  notes       String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  budget   Budget               @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category BudgetEntryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([budgetId, sortOrder])
  @@index([categoryId])
}

// ─── Attachments ────────────────────────────────────────────────
//
// Uploaded images and documents, stored in PostgreSQL (ADR 0010). The bytes
// live in AttachmentContent so listing attachments never reads them.

enum AttachmentKind {
  IMAGE
  DOCUMENT
}

enum AttachmentSource {
  UPLOAD // The web app
  UPLOAD_LINK // A short-lived upload link, e.g. handed out by an MCP client
  MCP_FILE // A file a chat client passed to an MCP tool
  URL // Downloaded from a URL on request
}

/// Belongs to exactly one plant, bed or project (a check constraint in the
/// migration enforces it).
model Attachment {
  id           String           @id @default(uuid()) @db.Uuid
  householdId  String           @db.Uuid
  plantId      String?          @db.Uuid
  bedId        String?          @db.Uuid
  projectId    String?          @db.Uuid
  kind         AttachmentKind
  fileName     String
  contentType  String
  byteSize     Int
  width        Int?
  height       Int?
  sha256       String
  caption      String?
  sortOrder    Int              @default(0)
  source       AttachmentSource @default(UPLOAD)
  sourceUrl    String?
  uploadedById String?          @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  household  Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  plant      Plant?             @relation(fields: [plantId], references: [id], onDelete: Cascade)
  bed        GardenBed?         @relation(fields: [bedId], references: [id], onDelete: Cascade)
  project    Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  content    AttachmentContent?

  @@index([householdId])
  @@index([plantId, sortOrder])
  @@index([bedId, sortOrder])
  @@index([projectId, sortOrder])
}

model AttachmentContent {
  attachmentId String @id @db.Uuid
  data         Bytes
  /// Small WebP preview for images; null for documents.
  thumbnail    Bytes?

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

/// A short-lived link that lets whoever holds it upload files to one plant,
/// bed or project, without logging in: an MCP client hands it to the user, or
/// uses it from its own sandbox. Only a hash of the token is stored.
model AttachmentUploadLink {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique
  householdId String   @db.Uuid
  createdById String   @db.Uuid
  /// "plant", "bed" or "project"; checked again on every upload.
  targetType  String
  targetId    String   @db.Uuid
  caption     String?
  maxFiles    Int
  usedCount   Int      @default(0)
  /// The MCP client that asked for the link, if any.
  clientId    String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

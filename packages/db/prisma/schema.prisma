generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js models ──────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  /// Pages (nav ids such as "lists" or "hendelser") in the phone's bottom
  /// bar, in order. Empty means the default selection; the rest are behind
  /// "Mer". See `apps/web/lib/navigation.ts`.
  quickNavPages String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts                 Account[]
  sessions                 Session[]
  householdMembers         HouseholdMember[]
  assignedItems            ShoppingItem[]                 @relation("AssignedItems")
  createdLists             ShoppingList[]                 @relation("CreatedShoppingLists")
  createdLinks             ShareLink[]
  mcpAuthorizationRequests McpOAuthAuthorizationRequest[]
  mcpAuthorizationCodes    McpOAuthAuthorizationCode[]
  mcpGrants                McpOAuthGrant[]
  mcpAuditEvents           McpAuditEvent[]
  uploadedAttachments      Attachment[]
  attachmentUploadLinks    AttachmentUploadLink[]
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ──────────────────────────────────────────────────

enum Role {
  OWNER
  MEMBER
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum ItemStatus {
  PENDING
  PURCHASED
  SKIPPED
}

/// Renamed from TaskStatus in migration 20261108170000.
enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

/// What kind of project it is. Existing maintenance tasks became MAINTENANCE.
enum ProjectType {
  MAINTENANCE
  REPAIR
  RENOVATION
  IMPROVEMENT
  OTHER
}

/// How big a project is: routine upkeep (cleaning gutters) or a larger
/// construction job (draining, paving). Orthogonal to `ProjectType`; the
/// projects page and its numbers are split on it.
enum ProjectScale {
  ROUTINE
  MAJOR
}

/// Who does the work. Null means not decided yet.
enum ProjectExecution {
  SELF
  VENDOR
  MIXED
}

model Household {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  /// Last day of the move-in period. Purchases up to and including this day
  /// (Europe/Oslo) count as move-in purchases in the shopping numbers.
  moveInPeriodEndsOn DateTime? @db.Date
  createdAt          DateTime  @default(now())

  members        HouseholdMember[]
  lists          ShoppingList[]
  categories     Category[]
  projects       Project[]
  plants         Plant[]
  gardenBeds     GardenBed[]
  attachments    Attachment[]
  uploadLinks    AttachmentUploadLink[]
  budget         Budget?
  mcpAuditEvents McpAuditEvent[]
  calendarEvents CalendarEvent[]
  packingLists   PackingList[]
  packingBundles PackingBundle[]
  packingPersons PackingPerson[]
}

model HouseholdMember {
  /// Home Overview currently supports exactly one active household per user.
  /// Supporting multiple households requires an explicit active-household concept.
  userId      String @unique @db.Uuid
  householdId String @db.Uuid
  role        Role   @default(MEMBER)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@id([userId, householdId])
}

// ─── MCP OAuth models ───────────────────────────────────────────

enum McpOAuthClientRegistrationSource {
  CLIENT_ID_METADATA
  DYNAMIC
  ADMIN
}

enum McpOAuthClientStatus {
  ACTIVE
  REVOKED
}

model McpOAuthClient {
  id                 String                           @id @db.VarChar(512)
  name               String                           @db.VarChar(200)
  redirectUris       String[]
  grantTypes         String[]
  responseTypes      String[]
  clientSecretHash   String?                          @unique @db.Char(64)
  registrationSource McpOAuthClientRegistrationSource
  status             McpOAuthClientStatus             @default(ACTIVE)
  createdAt          DateTime                         @default(now())
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?

  authorizationRequests McpOAuthAuthorizationRequest[]
  authorizationCodes    McpOAuthAuthorizationCode[]
  grants                McpOAuthGrant[]

  @@index([expiresAt])
  @@index([status, revokedAt])
}

model McpOAuthAuthorizationRequest {
  id                  String    @id @default(uuid()) @db.Uuid
  requestTokenHash    String    @unique @db.Char(64)
  clientId            String    @db.VarChar(512)
  userId              String?   @db.Uuid
  redirectUri         String    @db.Text
  codeChallenge       String    @db.VarChar(128)
  codeChallengeMethod String    @db.VarChar(16)
  requestedScopes     String[]
  resource            String    @db.Text
  state               String?   @db.Text
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  consumedAt          DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?

  client McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model McpOAuthAuthorizationCode {
  id                  String    @id @default(uuid()) @db.Uuid
  codeHash            String    @unique @db.Char(64)
  clientId            String    @db.VarChar(512)
  userId              String    @db.Uuid
  redirectUri         String    @db.Text
  scopes              String[]
  resource            String    @db.Text
  codeChallenge       String    @db.VarChar(128)
  codeChallengeMethod String    @db.VarChar(16)
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  consumedAt          DateTime?

  client McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model McpOAuthGrant {
  id         String    @id @default(uuid()) @db.Uuid
  clientId   String    @db.VarChar(512)
  userId     String    @db.Uuid
  scopes     String[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?
  revokedAt  DateTime?

  client        McpOAuthClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens McpOAuthRefreshToken[]

  // Re-consent updates this row; a user/client pair never has two active grants.
  @@unique([userId, clientId])
  @@index([userId, revokedAt])
  @@index([clientId, revokedAt])
}

model McpOAuthRefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @db.Char(64)
  grantId      String    @db.Uuid
  familyId     String    @db.Uuid
  replacedById String?   @unique @db.Uuid
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  lastUsedAt   DateTime?
  consumedAt   DateTime?
  revokedAt    DateTime?

  grant      McpOAuthGrant         @relation(fields: [grantId], references: [id], onDelete: Cascade)
  replacedBy McpOAuthRefreshToken? @relation("McpRefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   McpOAuthRefreshToken? @relation("McpRefreshTokenRotation")

  @@index([grantId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

/// One row per MCP mutation attempt (chapter 12 of the MCP plan). Deliberately
/// holds no tool input, no before/after copies and no free text: only who, which
/// client, which tool, which resource and how it went. Rows are removed by the
/// periodic cleanup after the retention period, and with the user or household.
model McpAuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now())
  userId        String   @db.Uuid
  householdId   String   @db.Uuid
  /// Not a foreign key: the trail should survive a client being removed.
  clientId      String   @db.VarChar(512)
  toolName      String   @db.VarChar(100)
  resourceType  String   @db.VarChar(50)
  resourceId    String?  @db.Uuid
  /// `success`, `dry_run` or a lowercased application error code.
  outcome       String   @db.VarChar(32)
  correlationId String?  @db.Uuid
  durationMs    Int

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@index([clientId, createdAt])
  @@index([createdAt])
}

/// Database-only invariant, not expressible in Prisma (migration
/// 20260427141000): `CHECK (NOT "isPrivate" OR "createdById" IS NOT NULL)`.
/// A private list always has an owner, so `createdBy`'s `SetNull` would fail for
/// private lists; deleting a user removes their private lists first
/// (`lib/application/users/delete.ts`).
model ShoppingList {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  color       String?
  householdId String   @db.Uuid
  createdById String?  @db.Uuid
  isPrivate   Boolean  @default(false)
  /// Optional project the list buys for. Must be in the same household; the
  /// shopping write services enforce that. Deleting the project keeps the list.
  projectId   String?  @db.Uuid
  /// Optional calendar event the list buys gifts for (gift wishes). Same
  /// household rule as `projectId`; deleting the event keeps the list.
  eventId     String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household  Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy  User?          @relation("CreatedShoppingLists", fields: [createdById], references: [id], onDelete: SetNull)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  event      CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  items      ShoppingItem[]
  shareLinks ShareLink[]

  @@index([householdId, isPrivate])
  @@index([projectId])
  @@index([eventId])
}

model ShoppingItem {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  categoryId     String?    @db.Uuid
  priority       Priority   @default(MEDIUM)
  dueDate        DateTime?
  estimatedPrice Decimal?   @db.Decimal(10, 2)
  url            String?
  imageUrl       String?
  storeName      String?
  assignedToId   String?    @db.Uuid
  status         ItemStatus @default(PENDING)
  purchasedAt    DateTime?
  listId         String     @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  /// The household wants to hear when this item is on offer. An assistant
  /// checks the stores (MCP `list-deal-watch-items`) and reports what it finds.
  dealWatch       Boolean   @default(false)
  /// What counts as a good offer: brand, model, size. Read by the assistant.
  dealWatchNote   String?
  /// An offer at or below this price (NOK) is worth reporting.
  dealTargetPrice Decimal?  @db.Decimal(10, 2)
  /// Last time an assistant checked the stores for this item.
  dealCheckedAt   DateTime?

  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedTo   User?                @relation("AssignedItems", fields: [assignedToId], references: [id], onDelete: SetNull)
  list         ShoppingList         @relation(fields: [listId], references: [id], onDelete: Cascade)
  alternatives ProductAlternative[]
  deal         ShoppingItemDeal?

  @@index([dealWatch])
}

/// The best store offer found for a shopping item: one per item, and a new
/// report replaces it. Writing is separate from the item's own fields so a
/// scheduled job never races the household's edits. An offer counts as current
/// until `validTo` (Europe/Oslo), or for a week after it was reported when the
/// store gave no end date; older rows are ignored on read and replaced or
/// cleared by the next report.
model ShoppingItemDeal {
  id           String    @id @default(uuid()) @db.Uuid
  itemId       String    @unique @db.Uuid
  store        String
  /// The concrete product on offer, e.g. "Bosch Serie 6 WAU28PH9SN".
  productName  String?
  price        Decimal   @db.Decimal(10, 2)
  regularPrice Decimal?  @db.Decimal(10, 2)
  /// Conditions that are not a price: "med medlemskort", "3 for 2".
  priceNote    String?
  url          String?
  validFrom    DateTime? @db.Date
  /// Last day the offer applies.
  validTo      DateTime? @db.Date
  /// When the offer was last reported. Starts the one-week window when the
  /// store gave no end date.
  reportedAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  item ShoppingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model ProductAlternative {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  price     Decimal? @db.Decimal(10, 2)
  url       String?
  imageUrl  String?
  storeName String?
  notes     String?
  rank      Int      @default(0)
  itemId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item ShoppingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, rank])
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  icon        String?
  color       String?
  householdId String  @db.Uuid
  isDefault   Boolean @default(false)

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingItem[]

  @@unique([name, householdId])
}

model ShareLink {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  listId    String    @db.Uuid
  createdBy String    @db.Uuid
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  list    ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  creator User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}

// ─── Project models ─────────────────────────────────────────────
//
// Renamed from MaintenanceTask, TaskVendor and TaskProgressEntry in migration
// 20261108170000: the page started as a move-in maintenance list and now holds
// every home project, whether done by a vendor or by the household itself.

model Project {
  id                String            @id @default(uuid()) @db.Uuid
  title             String
  description       String?           @db.Text
  type              ProjectType       @default(OTHER)
  scale             ProjectScale      @default(ROUTINE)
  execution         ProjectExecution?
  priority          Priority          @default(MEDIUM)
  status            ProjectStatus     @default(NOT_STARTED)
  estimatedDuration String?
  estimatedPrice    Decimal?          @db.Decimal(10, 2)
  dueDate           DateTime?
  householdId       String            @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  household     Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vendors       ProjectVendor[]
  steps         ProjectStep[]
  shoppingLists ShoppingList[]
  attachments   Attachment[]

  @@index([householdId, status])
}

model ProjectVendor {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  description    String?  @db.Text
  phone          String?
  email          String?
  website        String?
  estimatedPrice Decimal? @db.Decimal(10, 2)
  notes          String?  @db.Text
  isSelected     Boolean  @default(false)
  projectId      String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectStep {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  sortOrder   Int       @default(0)
  projectId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

// ─── Hendelser (calendar events) ────────────────────────────────
//
// Birthdays and other dates the household wants to remember (ADR 0015).
// Gift wishes are shopping items on lists linked through `ShoppingList.eventId`.

enum CalendarEventType {
  BIRTHDAY
  ANNIVERSARY
  HOLIDAY
  OTHER
}

enum CalendarEventRecurrence {
  /// Every year on the same day and month (birthdays, anniversaries).
  YEARLY
  /// Once, on the given year.
  NONE
}

/// The date is stored as parts so a yearly event can leave the year out
/// (a birthday where the birth year is unknown). A one-off event always has a
/// year; the write services enforce it and that the day exists. A yearly event
/// on 29 February falls on 28 February in other years.
model CalendarEvent {
  id          String                  @id @default(uuid()) @db.Uuid
  householdId String                  @db.Uuid
  /// For a birthday: the person's name ("Mormor").
  title       String
  type        CalendarEventType       @default(BIRTHDAY)
  recurrence  CalendarEventRecurrence @default(YEARLY)
  month       Int
  day         Int
  /// Birth year, wedding year, or the year of a one-off event.
  year        Int?
  notes       String?                 @db.Text
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  shoppingLists ShoppingList[]

  @@index([householdId, month, day])
}

// ─── Pakkelister ────────────────────────────────────────────────
//
// Packing lists and reusable bundles of things that go together (ADR 0016).
// Adding a bundle to a list copies its items, so a list is a snapshot that can
// be ticked off and edited without changing the bundle.

enum PackingSeason {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

enum PackingDuration {
  /// A day trip, no overnight stay.
  DAY
  /// One to three nights.
  WEEKEND
  /// Four to eight nights.
  WEEK
  /// More than eight nights.
  LONG
}

/// What a packing list is for (ADR 0017). Replaces name prefixes such as
/// "Mal:" that the lists used before.
enum PackingListKind {
  /// A reusable starting point, e.g. "Hytta vinter". Never packed; a trip is
  /// started from it with duplicate-packing-list.
  TEMPLATE
  /// A trip being planned or packed.
  TRIP
  /// A finished trip, kept for reference. Bundle updates never touch it.
  ARCHIVED
}

model PackingList {
  id          String           @id @default(uuid()) @db.Uuid
  householdId String           @db.Uuid
  name        String
  kind        PackingListKind  @default(TRIP)
  season      PackingSeason?
  duration    PackingDuration?
  abroad      Boolean          @default(false)
  /// When the trip starts, if planned.
  departureOn DateTime?        @db.Date
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  household Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     PackingItem[]
  groups    PackingListGroup[]
  bundles   PackingListBundle[]

  @@index([householdId, kind])
}

/// A bundle added to a list, and who its copy is for (null: shared). Kept
/// apart from the items, so a template keeps following its bundle even while
/// the bundle has no things (ADR 0017). Not unique in the database: deleting a
/// person can make two shared rows, which the services treat as one.
model PackingListBundle {
  id        String   @id @default(uuid()) @db.Uuid
  listId    String   @db.Uuid
  bundleId  String   @db.Uuid
  personId  String?  @db.Uuid
  createdAt DateTime @default(now())

  list   PackingList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  bundle PackingBundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  person PackingPerson? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([listId])
  @@index([bundleId])
  @@index([personId])
}

/// A sub-list on one packing list ("Til bilen", "Kjøpe før avreise"): things
/// that belong together on this trip without being a reusable bundle.
model PackingListGroup {
  id        String   @id @default(uuid()) @db.Uuid
  listId    String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list  PackingList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  items PackingItem[]

  @@index([listId, sortOrder])
}

model PackingItem {
  id           String   @id @default(uuid()) @db.Uuid
  listId       String   @db.Uuid
  name         String
  quantity     Int      @default(1)
  packed       Boolean  @default(false)
  notes        String?
  sortOrder    Int      @default(0)
  /// The bundle the item was copied from. Deleting the bundle keeps the item
  /// and clears the link.
  bundleId     String?  @db.Uuid
  /// The bundle item it was copied from, so a template can follow later
  /// changes to the bundle. Cleared when the bundle item is removed.
  bundleItemId String?  @db.Uuid
  /// Who the item is for. Null means shared, or not decided.
  personId     String?  @db.Uuid
  /// The sub-list it is in, if any.
  groupId      String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  list       PackingList        @relation(fields: [listId], references: [id], onDelete: Cascade)
  bundle     PackingBundle?     @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  bundleItem PackingBundleItem? @relation(fields: [bundleItemId], references: [id], onDelete: SetNull)
  person     PackingPerson?     @relation(fields: [personId], references: [id], onDelete: SetNull)
  group      PackingListGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([listId, sortOrder])
  @@index([bundleId])
  @@index([bundleItemId])
  @@index([personId])
  @@index([groupId])
}

/// Someone things are packed for: a member of the family, who need not use
/// the app (a child). Shared by every packing list in the household.
model PackingPerson {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household   Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items       PackingItem[]
  bundles     PackingBundle[]
  listBundles PackingListBundle[]

  @@unique([householdId, name])
}

/// A reusable group of things that are packed together ("Treningstøy",
/// "Vintertøy barn", "Utenlandsreise"). Empty `seasons` or `durations` means
/// any. With `autoAdd` the bundle is added to every new list that matches.
model PackingBundle {
  id          String            @id @default(uuid()) @db.Uuid
  householdId String            @db.Uuid
  name        String
  description String?
  seasons     PackingSeason[]   @default([])
  durations   PackingDuration[] @default([])
  /// Only for trips abroad (passport, travel insurance, adapter).
  abroadOnly  Boolean           @default(false)
  autoAdd     Boolean           @default(false)
  /// Whose bundle it is ("Astrids toalettsaker"): its things go to this
  /// person when the bundle is added without naming someone else.
  personId    String?           @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  household Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  person    PackingPerson?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  items     PackingBundleItem[]
  listItems PackingItem[]
  lists     PackingListBundle[]

  @@unique([householdId, name])
}

model PackingBundleItem {
  id              String   @id @default(uuid()) @db.Uuid
  bundleId        String   @db.Uuid
  name            String
  /// How many to pack when the trip's length is not set, or has no own number.
  quantity        Int      @default(1)
  /// How many for each trip length ("3 boksere til helg, 7 til uke"). Null
  /// falls back to `quantity`; `quantityForTrip` in packing/rules.ts.
  quantityDay     Int?
  quantityWeekend Int?
  quantityWeek    Int?
  quantityLong    Int?
  notes           String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bundle    PackingBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  listItems PackingItem[]

  @@index([bundleId, sortOrder])
}

// ─── Hage / Planter models ──────────────────────────────────────

enum WateringNeed {
  LOW
  MEDIUM
  HIGH
}

enum WateringMethod {
  MANUAL
  AUTOMATIC
}

enum SunNeed {
  FULL_SUN // Mye sol
  PARTIAL_SHADE // Halvskygge
  SHADE // Skygge / lite sol
}

enum PlantType {
  TREE // Tre
  SHRUB // Busk
  PERENNIAL // Staude
  ANNUAL // Ettårig
  FLOWER // Blomst
  HERB // Krydder/urt
  VEGETABLE // Grønnsak
  CLIMBER // Klatreplante
  GRASS // Gress/prydgress
  OTHER
}

enum Lifecycle {
  ANNUAL // Ettårig
  BIENNIAL // Toårig
  PERENNIAL // Flerårig
}

model Plant {
  id               String          @id @default(uuid()) @db.Uuid
  name             String
  species          String?
  description      String?         @db.Text
  careInstructions String?         @db.Text
  wateringNeed     WateringNeed?
  wateringMethod   WateringMethod?
  lastWateredAt    DateTime?
  sunNeed          SunNeed?
  lastPrunedAt     DateTime?
  pruningSeason    String?
  isToxic          Boolean         @default(false)
  toxicityNotes    String?
  plantType        PlantType?
  soilType         String?
  fertilizer       String?
  hardinessZone    String?
  lifecycle        Lifecycle?
  bloomTime        String?
  plantedAt        DateTime?
  pests            String?         @db.Text
  notes            String?         @db.Text
  imageUrl         String?
  sourceUrl        String?
  householdId      String          @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  placements  PlantPlacement[]
  attachments Attachment[]

  @@index([householdId])
}

/// A named bed or area in the garden. One plant can grow in several beds, so
/// placement is a separate join row rather than a field on the plant.
model GardenBed {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?  @db.Text
  sunExposure SunNeed?
  notes       String?  @db.Text
  householdId String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  placements  PlantPlacement[]
  attachments Attachment[]

  @@unique([householdId, name])
}

/// Where a plant grows. At most one row per plant and bed.
model PlantPlacement {
  id        String   @id @default(uuid()) @db.Uuid
  plantId   String   @db.Uuid
  bedId     String   @db.Uuid
  quantity  Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plant Plant     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  bed   GardenBed @relation(fields: [bedId], references: [id], onDelete: Cascade)

  @@unique([plantId, bedId])
  @@index([bedId])
}

// ─── Budget models ──────────────────────────────────────────────

enum BudgetEntryType {
  INCOME
  EXPENSE
  DEDUCTION
  SAVINGS
}

/// How often a budget entry's amount occurs. The calculation turns it into a
/// monthly amount; the stored amount stays what the bill or payslip says.
enum BudgetFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

enum BudgetLoanType {
  MORTGAGE
  STUDENT
  CAR
  CONSUMER
  OTHER
}

enum BudgetLoanRepaymentType {
  ANNUITY
  SERIAL
}

enum TripTransportType {
  AIR_OR_PUBLIC
  CAR
}

model Budget {
  id                  String   @id @default(uuid()) @db.Uuid
  householdId         String   @unique @db.Uuid
  taxDeductionPercent Decimal  @default(22) @db.Decimal(5, 2)
  /// Market value of the home, for the loan-to-value ratio.
  propertyValue       Decimal? @db.Decimal(14, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  household  Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  members    BudgetMember[]
  loans      BudgetLoan[]
  trips      BudgetTrip[]
  categories BudgetEntryCategory[]
  entries    BudgetEntry[]
}

model BudgetEntryCategory {
  id        String   @id @default(uuid()) @db.Uuid
  budgetId  String   @db.Uuid
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget  Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  entries BudgetEntry[]

  @@unique([budgetId, name])
  @@index([budgetId, sortOrder])
}

model BudgetMember {
  id                 String   @id @default(uuid()) @db.Uuid
  budgetId           String   @db.Uuid
  name               String
  grossMonthlyIncome Decimal  @db.Decimal(10, 2)
  taxPercent         Decimal  @db.Decimal(5, 2)
  /// Actual monthly payout. When set it replaces gross × (1 − tax).
  netMonthlyIncome   Decimal? @db.Decimal(10, 2)
  notes              String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, sortOrder])
}

model BudgetLoan {
  id                 String                  @id @default(uuid()) @db.Uuid
  budgetId           String                  @db.Uuid
  bankName           String
  loanName           String
  loanType           BudgetLoanType          @default(MORTGAGE)
  repaymentType      BudgetLoanRepaymentType @default(ANNUITY)
  principalAmount    Decimal                 @default(0) @db.Decimal(14, 2)
  annualInterestRate Decimal                 @default(0) @db.Decimal(6, 3)
  termMonths         Int                     @default(12)
  monthlyFees        Decimal                 @default(0) @db.Decimal(10, 2)
  fixedRateUntil     DateTime?               @db.Date
  notes              String?
  sortOrder          Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, sortOrder])
}

model BudgetTrip {
  id            String            @id @default(uuid()) @db.Uuid
  budgetId      String            @db.Uuid
  name          String
  transportType TripTransportType
  annualTrips   Int               @default(1)
  ticketPerTrip Decimal?          @db.Decimal(10, 2)
  tollPerTrip   Decimal?          @db.Decimal(10, 2)
  ferryPerTrip  Decimal?          @db.Decimal(10, 2)
  fuelPerTrip   Decimal?          @db.Decimal(10, 2)
  /// Parking, accommodation and the like. Applies to every transport type.
  otherPerTrip  Decimal?          @db.Decimal(10, 2)
  notes         String?
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, sortOrder])
}

model BudgetEntry {
  id          String          @id @default(uuid()) @db.Uuid
  budgetId    String          @db.Uuid
  name        String
  categoryId  String?         @db.Uuid
  type        BudgetEntryType
  /// The amount per occurrence, in NOK. See `frequency`.
  amount      Decimal         @db.Decimal(10, 2)
  frequency   BudgetFrequency @default(MONTHLY)
  provider    String?
  /// Day of the month the money comes in or goes out, 1–31.
  paymentDay  Int?
  /// When a contract's binding period ends or it renews.
  renewalDate DateTime?       @db.Date
  notes       String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  budget   Budget               @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category BudgetEntryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([budgetId, sortOrder])
  @@index([categoryId])
}

// ─── Attachments ────────────────────────────────────────────────
//
// Uploaded images and documents, stored in PostgreSQL (ADR 0010). The bytes
// live in AttachmentContent so listing attachments never reads them.

enum AttachmentKind {
  IMAGE
  DOCUMENT
}

enum AttachmentSource {
  UPLOAD // The web app
  UPLOAD_LINK // A short-lived upload link, e.g. handed out by an MCP client
  MCP_FILE // A file a chat client passed to an MCP tool
  URL // Downloaded from a URL on request
}

/// Belongs to exactly one plant, bed or project (a check constraint in the
/// migration enforces it).
model Attachment {
  id           String           @id @default(uuid()) @db.Uuid
  householdId  String           @db.Uuid
  plantId      String?          @db.Uuid
  bedId        String?          @db.Uuid
  projectId    String?          @db.Uuid
  kind         AttachmentKind
  fileName     String
  contentType  String
  byteSize     Int
  width        Int?
  height       Int?
  sha256       String
  caption      String?
  sortOrder    Int              @default(0)
  source       AttachmentSource @default(UPLOAD)
  sourceUrl    String?
  uploadedById String?          @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  household  Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  plant      Plant?             @relation(fields: [plantId], references: [id], onDelete: Cascade)
  bed        GardenBed?         @relation(fields: [bedId], references: [id], onDelete: Cascade)
  project    Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  content    AttachmentContent?

  @@index([householdId])
  @@index([plantId, sortOrder])
  @@index([bedId, sortOrder])
  @@index([projectId, sortOrder])
}

model AttachmentContent {
  attachmentId String @id @db.Uuid
  data         Bytes
  /// Small WebP preview for images; null for documents.
  thumbnail    Bytes?

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

/// A short-lived link that lets whoever holds it upload files to one plant,
/// bed or project, without logging in: an MCP client hands it to the user, or
/// uses it from its own sandbox. Only a hash of the token is stored.
model AttachmentUploadLink {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique
  householdId String   @db.Uuid
  createdById String   @db.Uuid
  /// "plant", "bed" or "project"; checked again on every upload.
  targetType  String
  targetId    String   @db.Uuid
  caption     String?
  maxFiles    Int
  usedCount   Int      @default(0)
  /// The MCP client that asked for the link, if any.
  clientId    String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
